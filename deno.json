{
  "tasks": {
    "surf": "deno run --allow-read --allow-write src/cli.ts",
    "examples-prepare": "deno run --allow-read=skills,examples --allow-write=examples src/prepare_examples.ts",
    "test": "deno test --allow-read --allow-write --allow-run test/",
    "typecheck": "deno check src/cli.ts src/diagnostics.ts src/formatter.ts src/prepare_examples.ts src/surface.ts test/surface_test.ts",
    "verify": "deno fmt --check && deno lint && deno task typecheck && deno task test",
    "check": "deno task verify"
  },
  "imports": {
    "@bgotink/kdl": "npm:@bgotink/kdl@0.4.0"
  },
  "fmt": {
    "include": [
      "src/",
      "test/",
      "deno.json",
      "mise.toml"
    ],
    "exclude": [
      "test/skill-evaluations.json"
    ],
    "indentWidth": 2,
    "lineWidth": 88,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "include": [
      "src/",
      "test/"
    ]
  }
}
