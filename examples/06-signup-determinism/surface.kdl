/- kdl-version 2

surface "0.1"

application "signupDeterminism" {
    purpose "Create an account through an accessible, consistently validated signup experience."

    stack "web" {
        target "browser"
        technology "markup" "html"
        technology "language" "javascript"
        technology "uiLibrary" "picoCss" version="2"
    }

    stack "service" {
        target "server"
        technology "language" "typescript"
        technology "runtime" "deno"
        technology "protocol" "httpJson"
        technology "storage" "memory"
    }
}

(enum)value "signupStatus" {
    "success"
    "invalid"
    "conflict"
}

collection "account" {
    (uuid)"id"
    (string)"email"
    (dateTime)"createdAt"
}

collection "signupResult" {
    (uint16)"httpStatus"
    (enum)"status" (value)"signupStatus"
    (uuid)"accountId" optional
    (array)"errors" optional {
        context "Contain objects with field and message string properties."
    }
}

function "registerAccount" {
    collection "signupInput" {
        (string)"email"
        (string)"password"
        (string)"confirmPassword"
        (boolean)"acceptedTerms"
    }

    input (collection)"signupInput"
    output (collection)"signupResult"

    logic {
        (collection)"signupInput" "Trim email and convert it to lowercase before validation or lookup."
        "Validate fields in this order: email, password, confirmPassword, acceptedTerms."
        "Email is invalid when empty or when it does not contain non-whitespace text before and after one @ character and a dot after @; use the message Enter a valid email address."
        "Password is invalid unless it contains at least 12 characters, one uppercase ASCII letter, one lowercase ASCII letter, and one ASCII digit; use the message Use at least 12 characters with uppercase, lowercase, and a number."
        "confirmPassword is invalid when it differs from password; use the message Passwords must match."
        "acceptedTerms is invalid unless it is true; use the message Accept the terms to continue."
        (collection)"signupResult" "If any field is invalid, output httpStatus 422, status invalid, omit accountId, and include one field and message error object for every invalid field in validation order."
        (collection)"account" "If an account already has the normalized email, output httpStatus 409, status conflict, omit accountId, and include one email error with message An account already exists for this email."
        (collection)"account" "Otherwise create exactly one account with a unique id, the normalized email, and the current date and time."
        (collection)"signupResult" "After creation output httpStatus 201, status success, the created accountId, and omit errors."
    }
}

interface "signup" {
    context (function)"registerAccount" "Render an accessible signup form using Pico CSS 2 with labelled email, password, confirm-password, and terms fields plus one Create account action."

    logic {
        "Start with an empty form, no errors, and the Create account action enabled."
        (function)"registerAccount" "On submission call this function once; while awaiting it, disable the form and announce Creating account."
        (function)"registerAccount" "For an invalid or conflict result, keep the normalized email and terms choice, clear both password fields, show every returned error beside its field, focus the first invalid field, re-enable the form, and announce that signup failed."
        (function)"registerAccount" "For a success result, replace the form with Account created and announce success."
    }
}

screen "home" {
    use (interface)"signup"
    logic "Use / as this screen's URL path."
}
