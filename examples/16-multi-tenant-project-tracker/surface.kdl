/- kdl-version 2

surface "0.1"

application "multiTenantProjectTracker" {
    purpose "Track projects and work items while isolating every tenant's resources and applying each user's tenant-specific role."

    stack "web" {
        target "browser"
        technology "markup" "html"
        technology "styling" "css"
        technology "language" "typescript"
        technology "api" "httpJson"
    }

    stack "service" {
        target "server"
        technology "language" "typescript"
        technology "runtime" "deno"
        technology "storage" "postgresql"
        technology "authentication" "oidc"
    }
}

(enum)value "tenantRole" {
    "owner"
    "administrator"
    "contributor"
    "viewer"
}

(enum)value "tenantPermission" {
    "tenantRead"
    "projectCreate"
    "projectUpdate"
    "workItemCreate"
    "workItemUpdate"
    "membershipManage"
}

(enum)value "workItemStatus" {
    "backlog"
    "active"
    "done"
}

collection "tenant" {
    (uuid)"id"
    (string)"name"
}

collection "tenantMembership" {
    (uuid)"tenantId"
    (uuid)"userId"
    (enum)"role" (value)"tenantRole"
}

collection "project" {
    (uuid)"tenantId"
    (uuid)"id"
    (string)"name"
    (string)"description" optional
    (integer)"version"
}

collection "workItem" {
    (uuid)"tenantId"
    (uuid)"projectId"
    (uuid)"id"
    (string)"title"
    (enum)"status" (value)"workItemStatus"
    (uuid)"assigneeUserId" optional
    (integer)"version"
}

collection "authorizationRequest" {
    (uuid)"actorUserId"
    (uuid)"tenantId"
    (enum)"permission" (value)"tenantPermission"
}

collection "authorizationDecision" {
    (boolean)"allowed"
    (enum)"role" (value)"tenantRole" optional
}

collection "userTenantList" {
    (array)"memberships"
}

collection "tenantWorkspace" {
    (uuid)"tenantId"
    (array)"projects"
    (array)"workItems"
}

function "authorizeTenantAction" {
    input (collection)"authorizationRequest"
    output (collection)"authorizationDecision"

    logic {
        (collection)"tenantMembership" "Find a membership whose tenantId and userId exactly equal the request tenantId and actorUserId; never use a membership from another tenant, even for the same user."
        (collection)"authorizationDecision" "If no exact membership exists, output allowed false and omit role."
        (value)"tenantPermission" "Allow owner for every permission; allow administrator for every permission except membershipManage; allow contributor only for tenantRead, workItemCreate, and workItemUpdate; and allow viewer only for tenantRead."
        (collection)"authorizationDecision" "Output allowed true with the exact membership role when the role grants the requested permission; otherwise output allowed false with that role."
    }
}

function "listUserTenants" {
    collection "userIdentityInput" {
        (uuid)"actorUserId"
    }

    input (collection)"userIdentityInput"
    output (collection)"userTenantList"

    logic {
        (collection)"userIdentityInput" "Bind actorUserId exclusively from the authenticated identity and never from a caller-selected user identifier."
        (collection)"tenantMembership" "Read only memberships whose userId exactly equals actorUserId; preserve independent roles when that user belongs to several tenants."
        (collection)"tenant" "For each matching membership, include only its tenant's id and name together with that membership's role."
        (collection)"userTenantList" "Output memberships as an array of objects with exactly tenantId, tenantName, and role; order them by tenantName and then tenantId."
    }
}

function "loadTenantWorkspace" {
    collection "tenantWorkspaceInput" {
        (uuid)"actorUserId"
        (uuid)"tenantId"
    }

    input (collection)"tenantWorkspaceInput"
    output (collection)"tenantWorkspace"

    logic {
        (function)"authorizeTenantAction" "Call this function with actorUserId, tenantId, and tenantRead; if it denies access, output null without revealing whether the tenant exists."
        (collection)"project" "Read only projects whose tenantId exactly equals the authorized tenantId, and order them by name and then id."
        (collection)"workItem" "Read only work items whose tenantId exactly equals the authorized tenantId and whose projectId identifies a project from that same tenant; order them by projectId, status, title, and id."
        (collection)"tenantWorkspace" "Output the authorized tenantId, the ordered project objects in projects, and the ordered work-item objects in workItems; every array object must contain exactly the fields declared by its referenced collection."
    }
}

function "createProject" {
    collection "createProjectInput" {
        (uuid)"actorUserId"
        (uuid)"tenantId"
        (string)"name"
        (string)"description" optional
    }

    input (collection)"createProjectInput"
    output (collection)"project"

    logic {
        (function)"authorizeTenantAction" "Call this function with actorUserId, tenantId, and projectCreate; if it denies access, output null without revealing whether the tenant exists."
        (collection)"createProjectInput" "Trim name; if it is empty, output null."
        (collection)"project" "Within the authorized tenant, require name to be unique without regard to letter case; if it conflicts, output null."
        (collection)"project" "Generate a new id, copy only the authorized tenantId, set version to 1, persist the project, and output it; never accept or derive tenantId from any other source."
    }
}

function "updateProject" {
    collection "updateProjectInput" {
        (uuid)"actorUserId"
        (uuid)"tenantId"
        (uuid)"projectId"
        (integer)"expectedVersion"
        (string)"name"
        (string)"description" optional
    }

    input (collection)"updateProjectInput"
    output (collection)"project"

    logic {
        (function)"authorizeTenantAction" "Call this function with actorUserId, tenantId, and projectUpdate; if it denies access, output null."
        (collection)"project" "Find the project only by the composite key tenantId and projectId; for a missing project or an identifier belonging to another tenant, output the same null result."
        (collection)"updateProjectInput" "Trim name; if it is empty or expectedVersion does not equal the stored version, output null without changing the project."
        (collection)"project" "Within tenantId, require the new name to be unique without regard to letter case except for this project."
        (collection)"project" "Update name and description, increment version by 1, preserve tenantId and id unchanged, persist atomically, and output the project."
    }
}

function "createWorkItem" {
    collection "createWorkItemInput" {
        (uuid)"actorUserId"
        (uuid)"tenantId"
        (uuid)"projectId"
        (string)"title"
        (uuid)"assigneeUserId" optional
    }

    input (collection)"createWorkItemInput"
    output (collection)"workItem"

    logic {
        (function)"authorizeTenantAction" "Call this function with actorUserId, tenantId, and workItemCreate; if it denies access, output null."
        (collection)"project" "Find the parent only by tenantId and projectId; for a missing project or a project in another tenant, output the same null result."
        (collection)"createWorkItemInput" "Trim title; if it is empty, output null."
        (collection)"tenantMembership" "If assigneeUserId is present, require a membership with exactly tenantId and assigneeUserId; a membership in any other tenant does not satisfy this constraint."
        (collection)"workItem" "Generate a new id, copy tenantId and projectId from the authorized same-tenant scope, set status to backlog and version to 1, persist the work item, and output it."
    }
}

function "updateWorkItem" {
    collection "updateWorkItemInput" {
        (uuid)"actorUserId"
        (uuid)"tenantId"
        (uuid)"workItemId"
        (integer)"expectedVersion"
        (string)"title"
        (enum)"status" (value)"workItemStatus"
        (uuid)"assigneeUserId" optional
        (boolean)"clearAssignee"
    }

    input (collection)"updateWorkItemInput"
    output (collection)"workItem"

    logic {
        (function)"authorizeTenantAction" "Call this function with actorUserId, tenantId, and workItemUpdate; if it denies access, output null."
        (collection)"workItem" "Find the work item only by the composite key tenantId and workItemId; for a missing item or an identifier belonging to another tenant, output the same null result."
        (collection)"updateWorkItemInput" "Trim title; if it is empty, expectedVersion differs from the stored version, or clearAssignee is true while assigneeUserId is present, output null without changing the work item."
        (collection)"tenantMembership" "If assigneeUserId is present, require a membership with exactly tenantId and assigneeUserId; a membership in any other tenant does not satisfy this constraint."
        (collection)"workItem" "Update title and status, clear the assignee when clearAssignee is true or otherwise apply a present assigneeUserId, increment version by 1, preserve tenantId, projectId, and id unchanged, persist atomically, and output the work item."
    }
}

function "setTenantMembership" {
    collection "setTenantMembershipInput" {
        (uuid)"actorUserId"
        (uuid)"tenantId"
        (uuid)"memberUserId"
        (enum)"role" (value)"tenantRole"
    }

    input (collection)"setTenantMembershipInput"
    output (collection)"tenantMembership"

    logic {
        (function)"authorizeTenantAction" "Call this function with actorUserId, tenantId, and membershipManage; if it denies access, output null without revealing whether the tenant exists."
        (collection)"tenantMembership" "Upsert only the membership identified by the composite key tenantId and memberUserId, so the same user may keep different roles in other tenants."
        (collection)"tenantMembership" "Do not change tenantId on an existing membership and never copy a role to another tenant; persist and output exactly the one membership."
    }
}

interface "projectTracker" {
    context (collection)"tenant" (collection)"project" (collection)"workItem" "Render an accessible tenant selector, project list, work-item list, and forms for the operations the selected tenant role permits."

    logic {
        (function)"listUserTenants" "After authentication, call this function and offer exactly its returned tenants with each tenant-specific role; do not offer a tenant from any other source."
        (function)"loadTenantWorkspace" "When a tenant is selected or its data is refreshed, call this function with the authenticated user and selected tenant."
        (collection)"tenantWorkspace" "Replace the visible projects and work items only when the output tenantId still equals the selected tenantId; discard prior tenant data before a switch and discard stale responses from another selection."
        (function)"createProject" "Offer project creation only for owner or administrator, call this function for submission, and refresh the selected tenant after a non-null output."
        (function)"updateProject" "Offer project editing only for owner or administrator, submit the displayed version, and refresh the selected tenant after a non-null output."
        (function)"createWorkItem" "Offer work-item creation for owner, administrator, or contributor, call this function for submission, and refresh the selected tenant after a non-null output."
        (function)"updateWorkItem" "Offer work-item editing for owner, administrator, or contributor, submit the displayed version, and refresh the selected tenant after a non-null output."
        (function)"setTenantMembership" "Offer membership management only for owner, call this function for submission, and reload the tenant list after a non-null output."
        "For every null operation result, show the same non-specific unavailable message and do not reveal whether a tenant, project, work item, membership, or identifier exists."
    }
}

screen "home" {
    use (interface)"projectTracker"
    logic "Use / as this screen's URL path and require an authenticated user."
}
