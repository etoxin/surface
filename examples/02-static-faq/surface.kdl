/- kdl-version 2

surface "0.1"

application "surfaceFaq" {
    purpose "Answer common questions about Surface."
}

interface "surfaceFaq" {
    // Begin with the broadest question.
    context """
        Render a user interface containing an FAQ with these exact questions and answers, in order.

        Question: What is Surface?
        Answer: Surface is a small format for describing an application.

        It records what the application should contain without choosing an implementation framework.

        Question: Is Surface a programming language?
        Answer: No. Surface is a specification format rather than an executable language.

        Question: Does every screen need a route?
        Answer: No. Add a route when a screen has a URL or similar address.

        Leave it out for screens that are not addressable.
        """
}

screen "faq" route="/faq" {
    use (interface)"surfaceFaq"
}
