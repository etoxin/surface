  "functions": [
    {
      "id": "createShortLink",
      "collections": [
        {
          "id": "createShortLinkInput",
          "fields": [
            {
              "name": "destination",
              "type": "url"
            },
            {
              "name": "customSlug",
              "type": "string",
              "optional": true
            },
            {
              "name": "authorization",
              "type": "string"
            }
          ]
        }
      ],
      "input": {
        "collection": "createShortLinkInput"
      },
      "output": {
        "collection": "createShortLinkResult"
      },
      "logic": [
        {
          "instruction": "Expose this operation as HTTP POST /links."
        },
        {
          "instruction": "Read destination and optional customSlug from the JSON request body, and read authorization from the Authorization header.",
          "reference": {
            "type": "collection",
            "id": "createShortLinkInput"
          }
        },
        {
          "instruction": "Require a valid API credential because this operation is protected; otherwise output httpStatus 401 and an error."
        },
        {
          "instruction": "If destination is invalid, output httpStatus 400 and an error."
        },
        {
          "instruction": "Require slug to be unique across all stored short links; if a requested slug already exists, output httpStatus 409 and an error.",
          "reference": {
            "type": "collection",
            "id": "shortLink"
          }
        },
        {
          "instruction": "Generate a slug when customSlug is omitted and combine it with this base URL.",
          "reference": {
            "type": "value",
            "id": "shortLinkBaseUrl"
          }
        },
        {
          "instruction": "Persist the new short link, then output it with httpStatus 201 and no error.",
          "reference": {
            "type": "collection",
            "id": "shortLink"
          }
        }
      ]
    },
    {
      "id": "resolveShortLink",
      "collections": [
        {
          "id": "resolveShortLinkInput",
          "fields": [
            {
              "name": "slug",
              "type": "string"
            },
            {
              "name": "authorization",
              "type": "string",
              "optional": true
            }
          ]
        }
      ],
      "input": {
        "collection": "resolveShortLinkInput"
      },
      "output": {
        "collection": "resolveShortLinkResult"
      },
      "logic": [
        {
          "instruction": "Expose this operation as HTTP GET /{slug}."
        },
        {
          "instruction": "Bind the slug path parameter to slug and read an optional credential from the Authorization header.",
          "reference": {
            "type": "collection",
            "id": "resolveShortLinkInput"
          }
        },
        {
          "instruction": "Find the stored short link with the unique matching slug; if none exists, output httpStatus 404 and an error.",
          "reference": {
            "type": "collection",
            "id": "shortLink"
          }
        },
        {
          "instruction": "This operation is public for an unprotected link; for a protected link require a valid credential, otherwise output httpStatus 401 or 403 and an error.",
          "reference": {
            "type": "collection",
            "id": "shortLink"
          }
        },
        {
          "instruction": "For an authorized match, output httpStatus 302, set location to the destination URL, and omit error.",
          "reference": {
            "type": "collection",
            "id": "resolveShortLinkResult"
          }
        }
      ]
    }
  ],
  "screens": [
