/- kdl-version 2

// Prototype only: Surface semantics hosted in KDL 2 syntax.
surface-lang "0.1"

application "teamTasks" version="0.1.0" specificationStatus="structuredDraft" {
    name "Team Tasks"
    purpose "Help small teams create, assign, and complete shared tasks."
}

actor "member" kind="human" {
    description "A person who creates and completes team tasks."
    responsibility "Create tasks."
    responsibility "Complete assigned tasks."
}

actor "administrator" kind="human" {
    description "A person who manages every task in the application."
}

value "taskTitle" base="string" {
    constraint "The title must contain between 1 and 120 characters."
    constraint "The title must not contain only whitespace."
}

enum "taskStatus" "open" "completed" "archived"

entity "user" {
    field "id" "uuid" generated=#true
    field "displayName" "string" maximumLength=100
    field "email" "email" unique=#true sensitive=#true
}

entity "task" {
    field "id" "uuid" generated=#true
    field "title" "taskTitle"
    field "owner" "user"
    field "status" "taskStatus" default="open"
    field "createdAt" "timestamp" generated=#true
    field "completedAt" "timestamp" optional=#true
}

event "taskCompleted" source="taskComplete" {
    payload "task" "task"
    payload "completedBy" "user"
}

policy "taskView" actor="member" resource="task" action="view" {
    allowWhen "The actor owns the task."
    allowWhen "The actor is an administrator."
}

policy "taskComplete" actor="member" resource="task" action="complete" {
    allowWhen "The actor owns the task."
    allowWhen "The actor is an administrator."
    denyWhen "The task status is not open."
}

behavior "taskComplete" actor="member" resource="task" policy="taskComplete" {
    input "task" "task"
    requires "The task status is open."
    effect "Set the task status to completed."
    effect "Record the current timestamp as completedAt."
    emits "taskCompleted"
    error "taskNotFound"
    error "permissionDenied"
    error "invalidTaskState"
    idempotent #false
}

query "taskGet" actor="member" policy="taskView" {
    input "taskId" "uuid"
    returns "task" nullable=#true
    requirement "Return the task matching taskId."
    requirement "Return null when the task does not exist."
}

workflow "taskLifecycle" entity="task" initialState="open" {
    state "open"
    state "completed"
    state "archived"

    transition "complete" from="open" to="completed" behavior="taskComplete" policy="taskComplete"
    transition "archive" from="completed" to="archived" {
        condition "The task satisfies the confirmed retention period."
    }

    invariant "A completed task must have a completedAt timestamp."
}

interface "taskApi" kind="http" basePath="/api" {
    authentication "Require an authenticated user."

    operation "getTask" method="GET" path="/tasks/{taskId}" query="taskGet" {
        response "success" 200
        response "notFound" 404
        response "permissionDenied" 403
    }

    operation "completeTask" method="POST" path="/tasks/{taskId}/complete" behavior="taskComplete" {
        response "success" 200
        response "notFound" 404
        response "permissionDenied" 403
        response "invalidTaskState" 409
    }
}

component "taskStatusBadge" {
    input "status" "taskStatus"
    state "open"
    state "completed"
    state "archived"
    requirement "Display the task status as text."
    requirement "Do not communicate the task status using colour alone."
}

screen "taskDetails" route="/tasks/:taskId" {
    actor "member"
    actor "administrator"
    data "taskGet"
    section "Task summary"
    section "Ownership"
    component "taskStatusBadge"

    action "completeTask" label="Complete Task" behavior="taskComplete" {
        visibleWhen "The task status is open."
    }

    state "loading" "Display a loading placeholder."
    state "notFound" "Display a task-not-found message."
    state "error" "Display an error message and a retry action."
}

scenario "memberCompletesOpenTask" {
    relatesTo "taskComplete"
    relatesTo "taskLifecycle"
    given "The actor owns the task."
    given "The task status is open."
    when "The actor completes the task."
    then "The task status becomes completed."
    then "The completion timestamp is recorded."
    then "Exactly one taskCompleted event is emitted."
}
