/- kdl-version 2

surface "0.1"

application "contactViewer" {
    purpose "Display a contact selected by identifier."
}

entity "contact" {
    (string)"id"
    (string)"name"
    (string)"email" optional {
        context "Validate this value as an email address."
    }
    (boolean)"active"
}

query "contactById" {
    context "Find the contact whose id equals the id input."

    entity "contactLookup" {
        (string)"id"
    }

    input (entity)"contactLookup"
    returns (entity)"contact"

    context "If there is no contact, return null."
}

screen "contact" route="/contacts" {
    context "Read the id input from the URL query parameter named id."
    use (query)"contactById"

    section "Contact" {
        title "Contact"
        field "name"
        field "email"
        field "active"
    }

    state "empty" {
        section "No contact selected" {
            title "Select a contact"
            text "Choose a contact identifier to view its details."
        }
    }

    state "notFound" {
        section "Contact not found" {
            title "Contact not found"
            text "No contact exists for the selected identifier."
        }
    }
}
