{
  "surfaceVersion": "0.1",
  "application": {
    "id": "contactViewer",
    "purpose": "Display a contact selected by identifier."
  },
  "collections": [
    {
      "id": "contact",
      "fields": [
        {
          "name": "id",
          "type": "string"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "email",
          "type": "string",
          "optional": true
        },
        {
          "name": "active",
          "type": "boolean"
        }
      ]
    }
  ],
  "functions": [
    {
      "id": "contactById",
      "collections": [
        {
          "id": "contactLookup",
          "fields": [
            {
              "name": "id",
              "type": "string"
            }
          ]
        }
      ],
      "input": {
        "collection": "contactLookup"
      },
      "output": {
        "collection": "contact"
      }
    }
  ],
  "interfaces": [
    {
      "id": "contactViewer"
    }
  ],
  "screens": [
    {
      "id": "home",
      "route": "/"
    },
    {
      "id": "contact",
      "route": "/contacts",
      "interface": "contactViewer"
    }
  ]
}
