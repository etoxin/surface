{
  "surfaceVersion": "0.1",
  "application": {
    "id": "contactViewer",
    "purpose": "Display a contact selected by identifier."
  },
  "collections": [
    {
      "id": "contact",
      "fields": [
        {
          "name": "id",
          "type": "string"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "email",
          "type": "string",
          "optional": true
        },
        {
          "name": "active",
          "type": "boolean"
        }
      ]
    }
  ],
  "functions": [
    {
      "id": "contactById",
      "collections": [
        {
          "id": "contactLookup",
          "fields": [
            {
              "name": "id",
              "type": "string"
            }
          ]
        }
      ],
      "input": {
        "collection": "contactLookup"
      },
      "output": {
        "collection": "contact"
      },
      "logic": [
        {
          "instruction": "Find the contact whose id equals this lookup id.",
          "reference": {
            "type": "collection",
            "id": "contactLookup"
          }
        },
        {
          "instruction": "If a matching contact exists, output it.",
          "reference": {
            "type": "collection",
            "id": "contact"
          }
        },
        {
          "instruction": "If no contact matches, output null."
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "contactViewer",
      "logic": [
        {
          "instruction": "When no id is provided, ask the user to select a contact.",
          "reference": {
            "type": "function",
            "id": "contactById"
          }
        },
        {
          "instruction": "When no contact matches, show that the contact was not found.",
          "reference": {
            "type": "function",
            "id": "contactById"
          }
        }
      ]
    }
  ],
  "screens": [
    {
      "id": "home",
      "logic": [
        {
          "instruction": "Use / as this screen's URL path."
        },
        {
          "instruction": "Open this screen.",
          "reference": {
            "type": "screen",
            "id": "contact"
          }
        }
      ]
    },
    {
      "id": "contact",
      "interface": "contactViewer",
      "logic": [
        {
          "instruction": "Use /contacts as this screen's URL path."
        }
      ]
    }
  ]
}
