/- kdl-version 2

surface "0.1"
application "contactViewer" { purpose "Display a contact." }
entity "contact" {
    (string)"id" required
}
query "contactById" by="id" {
    input "id" type="string"
    returns (entity)"contact" missing=#null
}
screen "contact" {
    use (query)"contactById"
    section "Contact" { field "id" }
    state "empty" {
        section "Empty" { text "Select a contact." }
    }
}
