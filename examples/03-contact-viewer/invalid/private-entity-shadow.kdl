/- kdl-version 2

surface "0.1"
application "contactViewer" { purpose "Display a contact." }
entity "contact" {
    (string)"id"
}
function "contactById" {
    entity "contact" {
        (string)"id"
    }
    input (entity)"contact"
    returns (entity)"contact"
}
screen "contact" {
    context "Render a contact."
}
