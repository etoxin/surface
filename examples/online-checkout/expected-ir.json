          }
        },
        {
          "instruction": "Refund the full captured amount with idempotencyKey followed by :refund; on a retryable failure output httpStatus 202 and leave the order unchanged.",
          "reference": {
            "type": "function",
            "id": "refundPayment"
          }
        },
        {
          "instruction": "Release any unconsumed reservation with idempotencyKey followed by :release and treat an already consumed reservation as requiring no release.",
          "reference": {
            "type": "function",
            "id": "releaseInventory"
          }
        },
        {
          "instruction": "After required compensation succeeds atomically set status cancelled; repeated identical requests output the same cancelled order with httpStatus 200.",
          "reference": {
            "type": "value",
            "id": "orders"
          }
        }
      ]
    }
