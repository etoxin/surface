          ]
        }
      ],
      "input": {
        "collection": "issueReceiptInput"
      },
      "output": {
        "collection": "receipt"
      },
      "logic": [
        {
          "instruction": "Allow only actorRoles containing checkoutService; otherwise output null."
        },
        {
          "instruction": "If orderId already has a receipt, output the existing immutable receipt.",
          "reference": {
            "type": "value",
            "id": "receipts"
          }
        },
        {
          "instruction": "Require a paid or fulfillmentPending order and a captured payment whose basket, total, and currency match it.",
          "reference": {
            "type": "value",
            "id": "orders"
          }
        },
        {
          "instruction": "Persist and output exactly one immutable receipt with a unique human-readable number and the current time.",
          "reference": {
            "type": "collection",
            "id": "receipt"
          }
        }
      ]
    },
    {
      "id": "enqueueFulfillment",
      "collections": [
        {
          "id": "enqueueFulfillmentInput",
          "fields": [
            {
              "name": "orderId",
              "type": "uuid"
            },
            {
              "name": "actorRoles",
              "type": "array"
            }
          ]
        }
      ],
      "input": {
        "collection": "enqueueFulfillmentInput"
      },
      "output": {
        "collection": "fulfillment"
      },
      "logic": [
        {
          "instruction": "Allow only actorRoles containing checkoutService; otherwise output null."
        },
        {
          "instruction": "If orderId already has fulfillment work, output it without enqueueing a duplicate.",
          "reference": {
            "type": "value",
            "id": "fulfillments"
          }
        },
        {
          "instruction": "In one database transaction create queued fulfillment with attemptCount 0, write its outbox event, and set the paid order to fulfillmentPending.",
          "reference": {
            "type": "value",
            "id": "orders"
          }
        },
        {
          "instruction": "If that transaction fails, output null without publishing an event or changing the order."
        },
        {
          "instruction": "Publish committed outbox events asynchronously with at-least-once delivery and retain them until acknowledged."
        }
      ]
    },
    {
      "id": "runFulfillmentJob",
      "collections": [
        {
          "id": "runFulfillmentJobInput",
          "fields": [
            {
              "name": "fulfillmentId",
              "type": "uuid"
            },
            {
              "name": "actorRoles",
              "type": "array"
            }
          ]
        }
      ],
      "input": {
        "collection": "runFulfillmentJobInput"
      },
      "output": {
        "collection": "fulfillment"
      },
      "logic": [
        {
          "instruction": "Allow only actorRoles containing fulfillmentWorker; otherwise output null."
        },
        {
          "instruction": "Acquire one expired-or-unowned lease for fulfillmentId; acknowledge a duplicate event without work when status is shipped or delivered.",
          "reference": {
            "type": "value",
            "id": "fulfillments"
          }
        },
        {
          "instruction": "Call the carrier create-shipment operation with orderId as its idempotency key and a ten-second timeout; after an unknown result query by orderId before retrying."
        },
        {
          "instruction": "On success atomically store carrierReference and trackingUrl, set status shipped, clear nextAttemptAt, and acknowledge the event.",
          "reference": {
            "type": "value",
            "id": "fulfillments"
          }
        },
        {
          "instruction": "On failure increment attemptCount; below this limit set queued with exponential backoff and release the event, otherwise set failed, clear nextAttemptAt, acknowledge the event, and raise an operational alert.",
          "reference": {
            "type": "value",
            "id": "fulfillmentRetryLimit"
          }
        },
        {
          "instruction": "Set the order to fulfilled when shipment succeeds, or needsAttention when the final attempt fails.",
          "reference": {
            "type": "value",
            "id": "orders"
          }
        }
      ]
    },
    {
      "id": "checkoutBasket",
      "collections": [
        {
          "id": "checkoutBasketInput",
          "fields": [
            {
              "name": "actorId",
              "type": "uuid"
            },
            {
              "name": "actorRoles",
              "type": "array"
            },
            {
              "name": "basketId",
              "type": "uuid"
            },
            {
              "name": "expectedVersion",
              "type": "uint32"
            },
            {
              "name": "shippingAddress",
              "type": "object"
            },
            {
              "name": "paymentToken",
              "type": "string"
            },
            {
              "name": "idempotencyKey",
              "type": "string"
            }
          ]
        }
      ],
      "input": {
        "collection": "checkoutBasketInput"
      },
      "output": {
        "collection": "checkoutResult"
      },
      "logic": [
        {
          "instruction": "Expose this operation as HTTP POST /baskets/{basketId}/checkout; require an authenticated customer."
        },
        {
          "instruction": "Atomically return the prior terminal result for the same actorId, basketId, idempotencyKey, expectedVersion, and request fingerprint; output httpStatus 409 for key reuse with different input.",
          "reference": {
            "type": "collection",
            "id": "checkoutResult"
          }
        },
        {
          "instruction": "Output httpStatus 404 if basketId is absent, 403 unless actorId owns it, 409 unless it is open at expectedVersion, and 422 if it has no items or shippingAddress is invalid or outside the configured country allowlist.",
          "reference": {
            "type": "value",
            "id": "baskets"
          }
        },
        {
          "instruction": "Reprice every item; output httpStatus 409 with status failed and errorCode priceChanged if any price differs, without reserving inventory or charging payment.",
          "reference": {
            "type": "value",
            "id": "basketItems"
          }
        },
        {
          "instruction": "Atomically change the basket from open to checkingOut at expectedVersion so concurrent checkout attempts cannot start another workflow.",
          "reference": {
            "type": "value",
            "id": "baskets"
          }
        },
        {
          "instruction": "Call this function for all current items with idempotencyKey followed by :inventory; if it does not output reserved, restore the basket to open and output unavailable for a stock rejection or pending for a retryable provider failure.",
          "reference": {
            "type": "function",
            "id": "reserveInventory"
          }
        },
        {
          "instruction": "After reservation succeeds, call this function for the exact basket subtotal and currency with idempotencyKey followed by :payment.",
          "reference": {
            "type": "function",
            "id": "chargePayment"
          }
        },
        {
          "instruction": "If payment is declined or fails, call this function with idempotencyKey followed by :release, restore the basket to open after release succeeds, and output declined or failed; if payment is pending, preserve checkingOut and output pending without releasing.",
          "reference": {
            "type": "function",
            "id": "releaseInventory"
          }
        },
        {
          "instruction": "After captured payment, atomically create exactly one paid order containing a snapshot of all basket items and shippingAddress, mark the reservation consumed, and mark the basket completed.",
          "reference": {
            "type": "value",
            "id": "orders"
          }
        },
        {
          "instruction": "If the order transaction fails after capture, call this function with idempotencyKey followed by :refund, release inventory, restore the basket to open only after both compensations succeed, and output failed; while either compensation is unresolved output pending and alert operations.",
          "reference": {
            "type": "function",
            "id": "refundPayment"
          }
        },
        {
          "instruction": "For the committed order, call this function and retain its immutable identifier.",
          "reference": {
            "type": "function",
            "id": "issueReceipt"
          }
        },
        {
          "instruction": "Call this function after receipt creation; if enqueueing fails, keep the paid order and receipt, set the order to needsAttention, alert operations, and continue to output checkout success.",
          "reference": {
            "type": "function",
            "id": "enqueueFulfillment"
          }
        },
        {
          "instruction": "Persist the terminal result before responding; output httpStatus 201 and succeeded with order, payment, receipt, and any fulfillment identifiers.",
          "reference": {
            "type": "collection",
            "id": "checkoutResult"
          }
        }
      ]
    },
