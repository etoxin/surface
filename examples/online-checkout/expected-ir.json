  "functions": [
    {
      "id": "createBasket",
      "collections": [
        {
          "id": "createBasketInput",
          "fields": [
            {
              "name": "actorId",
              "type": "uuid"
            },
            {
              "name": "actorRoles",
              "type": "array"
            }
          ]
        }
      ],
      "input": {
        "collection": "createBasketInput"
      },
      "output": {
        "collection": "basketResponse"
      },
      "logic": [
        {
          "instruction": "Expose this operation as HTTP POST /baskets and require an authenticated customer role; otherwise output httpStatus 401 or 403 with errorCode."
        },
        {
          "instruction": "Create one open basket owned by actorId with this currency, subtotal 0, and version 1.",
          "reference": {
            "type": "value",
            "id": "checkoutCurrency"
          }
        },
        {
          "instruction": "Persist the basket before outputting httpStatus 201 and its complete basket response with an empty items array.",
          "reference": {
            "type": "value",
            "id": "baskets"
          }
        }
      ]
    },
    {
      "id": "getBasket",
      "collections": [
        {
          "id": "getBasketInput",
          "fields": [
            {
              "name": "actorId",
              "type": "uuid"
            },
            {
              "name": "actorRoles",
              "type": "array"
            },
            {
              "name": "basketId",
              "type": "uuid"
            }
          ]
        }
      ],
      "input": {
        "collection": "getBasketInput"
      },
      "output": {
        "collection": "basketResponse"
      },
      "logic": [
        {
          "instruction": "Expose this operation as HTTP GET /baskets/{basketId}; output httpStatus 401 when authentication is absent."
        },
        {
          "instruction": "Find basketId; output httpStatus 404 when it does not exist, and output 403 unless actorId owns it or actorRoles contains supportAdministrator.",
          "reference": {
            "type": "value",
            "id": "baskets"
          }
        },
        {
          "instruction": "For an authorized basket, output httpStatus 200 with its fields and items as basketItem records ordered by id.",
          "reference": {
            "type": "value",
            "id": "basketItems"
          }
        }
      ]
    },
    {
      "id": "putBasketItem",
      "collections": [
        {
          "id": "putBasketItemInput",
          "fields": [
            {
              "name": "actorId",
              "type": "uuid"
            },
            {
              "name": "actorRoles",
              "type": "array"
            },
            {
              "name": "basketId",
              "type": "uuid"
            },
            {
              "name": "productId",
              "type": "string"
            },
            {
              "name": "quantity",
              "type": "uint32"
            },
            {
              "name": "observedUnitPrice",
              "type": "decimal"
            },
            {
              "name": "expectedVersion",
              "type": "uint32"
            }
          ]
        }
      ],
      "input": {
        "collection": "putBasketItemInput"
      },
      "output": {
        "collection": "basketResponse"
      },
      "logic": [
        {
          "instruction": "Expose this operation as HTTP PUT /baskets/{basketId}/items/{productId}; require an authenticated customer."
        },
        {
          "instruction": "Output httpStatus 404 if basketId does not exist, 403 if actorId is not its owner, 409 if it is not open or expectedVersion differs, and 422 if quantity is 0.",
          "reference": {
            "type": "value",
            "id": "baskets"
          }
        },
        {
          "instruction": "Fetch the current sellable price for productId from the inventory integration; output httpStatus 404 when the product is unknown, 409 with errorCode priceChanged when it differs from observedUnitPrice, and 503 for a transient integration failure."
        },
        {
          "instruction": "Atomically insert or replace the basketItem identified by basketId and productId with the validated quantity and current unit price.",
          "reference": {
            "type": "value",
            "id": "basketItems"
          }
        },
        {
          "instruction": "Atomically recompute subtotal from all item quantities multiplied by unit prices, increment version once, and output httpStatus 200 with the complete basket response.",
          "reference": {
            "type": "value",
            "id": "baskets"
          }
        }
      ]
    },
    {
      "id": "deleteBasketItem",
      "collections": [
        {
          "id": "deleteBasketItemInput",
          "fields": [
            {
              "name": "actorId",
              "type": "uuid"
            },
            {
              "name": "actorRoles",
              "type": "array"
            },
            {
              "name": "basketId",
              "type": "uuid"
            },
            {
              "name": "productId",
              "type": "string"
            },
            {
              "name": "expectedVersion",
              "type": "uint32"
            }
          ]
        }
      ],
      "input": {
        "collection": "deleteBasketItemInput"
      },
      "output": {
        "collection": "basketResponse"
      },
      "logic": [
        {
          "instruction": "Expose this operation as HTTP DELETE /baskets/{basketId}/items/{productId}; require an authenticated customer."
        },
        {
          "instruction": "Output httpStatus 404 if basketId does not exist, 403 if actorId is not its owner, and 409 if it is not open or expectedVersion differs.",
          "reference": {
            "type": "value",
            "id": "baskets"
          }
        },
        {
          "instruction": "Atomically remove the matching item; output httpStatus 404 if it does not exist.",
          "reference": {
            "type": "value",
            "id": "basketItems"
          }
        },
        {
          "instruction": "Atomically recompute subtotal, increment version once, and output httpStatus 200 with the complete basket response.",
          "reference": {
            "type": "value",
            "id": "baskets"
          }
        }
      ]
    },
    {
      "id": "reserveInventory",
      "collections": [
        {
          "id": "reserveInventoryInput",
          "fields": [
            {
              "name": "basketId",
              "type": "uuid"
            },
            {
              "name": "lines",
              "type": "array"
            },
            {
              "name": "idempotencyKey",
              "type": "string"
            },
            {
              "name": "actorRoles",
              "type": "array"
            }
          ]
        }
      ],
      "input": {
        "collection": "reserveInventoryInput"
      },
      "output": {
        "collection": "stockReservation"
      },
      "logic": [
        {
          "instruction": "Allow only actorRoles containing checkoutService; otherwise output a failed reservation with errorCode forbidden."
        },
        {
          "instruction": "Require INVENTORY_API_TOKEN at service startup, send it only over HTTPS, and never log it."
        },
        {
          "instruction": "Treat lines as basketItem productId and quantity pairs and reject empty, duplicate, or non-positive lines before calling the provider.",
          "reference": {
            "type": "collection",
            "id": "basketItem"
          }
        },
        {
          "instruction": "Call the inventory provider's bulk-reservation operation with idempotencyKey and a five-second timeout."
        },
        {
          "instruction": "Request one all-or-nothing reservation that expires this many seconds after provider acceptance.",
          "reference": {
            "type": "value",
            "id": "reservationLifetimeSeconds"
          }
        },
        {
          "instruction": "Return the existing reservation for the same idempotencyKey and identical input; reject reuse with different input, and persist exactly one terminal provider result.",
          "reference": {
            "type": "value",
            "id": "stockReservations"
          }
        },
        {
          "instruction": "Output reserved only when every line is reserved; output failed with unavailable for a stock rejection, or providerUnavailable with retryable true for timeout or transient failure.",
          "reference": {
            "type": "collection",
            "id": "stockReservation"
          }
        }
      ]
    },
    {
      "id": "releaseInventory",
      "collections": [
        {
          "id": "releaseInventoryInput",
          "fields": [
            {
              "name": "reservationId",
              "type": "uuid"
            },
            {
              "name": "idempotencyKey",
              "type": "string"
            },
            {
              "name": "actorRoles",
              "type": "array"
            }
          ]
        }
      ],
      "input": {
        "collection": "releaseInventoryInput"
      },
      "output": {
        "collection": "stockReservation"
      },
      "logic": [
        {
          "instruction": "Allow only actorRoles containing checkoutService; otherwise output a failed reservation with errorCode forbidden."
        },
        {
          "instruction": "If reservationId is already released or expired, output it unchanged so release is idempotent.",
          "reference": {
            "type": "value",
            "id": "stockReservations"
          }
        },
        {
          "instruction": "Call the inventory provider release operation with idempotencyKey and a five-second timeout."
        },
        {
          "instruction": "On success persist released; on a timeout preserve the prior status, set errorCode providerUnavailable and retryable true, and schedule retry with the same idempotencyKey.",
          "reference": {
            "type": "value",
            "id": "stockReservations"
          }
        }
      ]
    },
    {
      "id": "chargePayment",
      "collections": [
        {
          "id": "chargePaymentInput",
          "fields": [
            {
              "name": "basketId",
              "type": "uuid"
            },
            {
              "name": "amount",
              "type": "decimal"
            },
            {
              "name": "currency",
              "type": "string"
            },
            {
              "name": "paymentToken",
              "type": "string"
            },
            {
              "name": "idempotencyKey",
              "type": "string"
            },
            {
              "name": "actorRoles",
              "type": "array"
            }
          ]
        }
      ],
      "input": {
        "collection": "chargePaymentInput"
      },
      "output": {
        "collection": "paymentAttempt"
      },
      "logic": [
        {
          "instruction": "Allow only actorRoles containing checkoutService; otherwise output failed with errorCode forbidden."
        },
        {
          "instruction": "Require PAYMENT_API_TOKEN at service startup, send provider and one-time payment tokens only over HTTPS, and never persist or log either token."
        },
        {
          "instruction": "Atomically claim idempotencyKey; return the existing attempt for identical basketId, amount, and currency, and reject key reuse with different input.",
          "reference": {
            "type": "value",
            "id": "paymentAttempts"
          }
        },
        {
          "instruction": "Authorize and capture the exact amount and currency through the payment provider using idempotencyKey and a ten-second timeout."
        },
        {
          "instruction": "If the provider times out or its response is lost, query by idempotencyKey before any retry and never create a second charge."
        },
        {
          "instruction": "Persist and output captured for provider success, declined with retryable false for a decline, pending with retryable true while the provider outcome is unknown, or failed with the provider error classification.",
          "reference": {
            "type": "value",
            "id": "paymentAttempts"
          }
        }
      ]
    },
    {
      "id": "refundPayment",
      "collections": [
        {
          "id": "refundPaymentInput",
          "fields": [
            {
              "name": "paymentId",
              "type": "uuid"
            },
            {
              "name": "amount",
              "type": "decimal"
            },
            {
              "name": "idempotencyKey",
              "type": "string"
            },
            {
              "name": "actorRoles",
              "type": "array"
            }
          ]
        }
      ],
      "input": {
        "collection": "refundPaymentInput"
      },
      "output": {
        "collection": "paymentAttempt"
      },
      "logic": [
        {
          "instruction": "Allow only actorRoles containing checkoutService; otherwise output failed with errorCode forbidden."
        },
        {
          "instruction": "Reject an unknown payment or an amount other than its captured amount; if it is already refunded, output it unchanged.",
          "reference": {
            "type": "value",
            "id": "paymentAttempts"
          }
        },
        {
          "instruction": "Call the provider refund operation with idempotencyKey; on an unknown timeout result query by that key before retrying."
        },
        {
          "instruction": "Persist refunded exactly once on success; otherwise preserve captured status, record a retryable error, and raise an operational alert.",
          "reference": {
            "type": "value",
            "id": "paymentAttempts"
          }
        }
      ]
    },
    {
      "id": "issueReceipt",
      "collections": [
        {
