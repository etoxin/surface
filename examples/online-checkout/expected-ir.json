        "failed",
        "refunded"
      ]
    },
    {
      "id": "orderStatus",
      "type": "enum",
      "kind": "constant",
      "values": [
        "paid",
        "fulfillmentPending",
        "fulfilled",
        "cancelled",
        "needsAttention"
      ]
    },
    {
      "id": "fulfillmentStatus",
      "type": "enum",
      "kind": "constant",
      "values": [
        "queued",
        "processing",
        "shipped",
        "delivered",
        "failed"
      ]
    },
    {
      "id": "checkoutStatus",
      "type": "enum",
      "kind": "constant",
      "values": [
        "succeeded",
        "pending",
        "declined",
        "unavailable",
        "failed"
      ]
    },
