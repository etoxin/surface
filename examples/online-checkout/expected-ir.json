    {
      "id": "checkout",
      "logic": [
        {
          "instruction": "When an authenticated customer has no current basket, create one and display its empty state.",
          "reference": {
            "type": "function",
            "id": "createBasket"
          }
        },
        {
          "instruction": "Load the current basket; for 401 ask the customer to sign in, for 403 or 404 show no basket data, and for 200 display every returned item and subtotal.",
          "reference": {
            "type": "function",
            "id": "getBasket"
          }
        },
        {
          "instruction": "When an item quantity is added or changed, send the displayed price and version; replace the view only on 200, show price changes or conflicts without losing input, and allow retry for 503.",
          "reference": {
            "type": "function",
            "id": "putBasketItem"
          }
        },
        {
          "instruction": "When Remove is activated, send the displayed version; replace the view only on 200 and reload after a version conflict.",
          "reference": {
            "type": "function",
            "id": "deleteBasketItem"
          }
        },
        {
          "instruction": "Disable checkout while the basket is empty and require a complete shipping address and one-time payment token before submission."
        },
        {
          "instruction": "For the first submission generate one idempotency key, disable all basket edits, call this function once, and reuse that key for every retry of the unchanged submission.",
          "reference": {
            "type": "function",
            "id": "checkoutBasket"
          }
        },
        {
          "instruction": "On pending keep edits disabled, show that completion is being confirmed, and retry with bounded backoff; on declined or failed re-enable checkout without exposing provider details; on unavailable re-enable basket edits.",
          "reference": {
            "type": "function",
            "id": "checkoutBasket"
          }
        },
        {
          "instruction": "On succeeded clear payment inputs, never submit the charge again, show the receipt identifier, and open the order-status screen for orderId.",
          "reference": {
            "type": "function",
            "id": "checkoutBasket"
          }
        }
      ]
    },
