{
  "surfaceVersion": "0.1",
  "application": {
    "id": "onlineCheckout",
    "purpose": "Sell stocked products through an authorized, idempotent checkout flow and fulfill paid orders.",
    "stacks": [
      {
        "id": "web",
        "target": "browser",
        "technologies": [
          {
            "role": "markup",
            "name": "html"
          },
          {
            "role": "styling",
            "name": "css"
          },
          {
            "role": "designSystem",
            "name": "picoCss",
            "version": "2.1.1"
          },
          {
            "role": "language",
            "name": "typescript"
          },
          {
            "role": "protocol",
            "name": "https"
          }
        ]
      },
      {
        "id": "service",
        "target": "server",
        "technologies": [
          {
            "role": "language",
            "name": "typescript"
          },
          {
            "role": "runtime",
            "name": "deno"
          },
          {
            "role": "protocol",
            "name": "https"
          },
          {
            "role": "storage",
            "name": "postgresql"
          },
          {
            "role": "queue",
            "name": "transactionalOutbox"
          },
          {
            "role": "paymentProvider",
            "name": "externalPaymentApi"
          },
          {
            "role": "inventoryProvider",
            "name": "externalInventoryApi"
          }
        ]
      }
    ]
  },
  "values": [
    {
      "id": "checkoutCurrency",
      "type": "string",
      "kind": "constant",
      "initial": "USD"
    },
    {
      "id": "reservationLifetimeSeconds",
      "type": "number",
      "kind": "constant",
      "initial": 900
    },
    {
      "id": "fulfillmentRetryLimit",
