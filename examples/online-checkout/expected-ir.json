          "reference": {
            "type": "function",
            "id": "getOrder"
          }
        },
        {
          "instruction": "Offer Cancel only before fulfillment processing; generate one idempotency key per cancellation, reuse it for retries, show pending for 202, and show the cancelled state only after 200.",
          "reference": {
            "type": "function",
            "id": "cancelOrder"
          }
        },
